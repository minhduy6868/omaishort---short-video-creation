# OpenAI-compatible LLM (Ollama: http://127.0.0.1:11434/v1  model=qwen2.5:7b)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Image: ComfyUI first, then OpenAI images, then placeholder stills
COMFYUI_URL=http://127.0.0.1:8188
OPENAI_IMAGE_MODEL=dall-e-3

# TTS: edge-tts is default. Set key to use ElevenLabs instead.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Optional faster-whisper model (tiny/base/small). Captions fall back to even word split if missing.
WHISPER_MODEL=tiny

# API
API_HOST=127.0.0.1
API_PORT=8765
DATA_DIR=data
