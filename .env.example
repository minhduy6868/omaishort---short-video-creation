# ChatGPT Plus/Pro in-process (Playwright). Chromium opens ONLY for first login:
#   python -m omaishort --chatgpt-login
# Later jobs are headless and reuse one chatgpt.com thread per calendar day.
# CHATGPT_WEB_ENABLED=1
# CHATGPT_WEB_HEADED=0
# CHATGPT_WEB_MODEL=
# CHATGPT_WEB_TIMEOUT_MIN=8
#
# Gemini images: official HTTP (same adapter slot as Pollinations), not a Gemini UI scrape.
# GEMINI_API_KEY=
# GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
#
# Optional OpenAI-compatible / Ollama instead of (or after) ChatGPT web:
# OPENAI_API_KEY=ollama
# OPENAI_BASE_URL=http://127.0.0.1:11434/v1
# OPENAI_MODEL=qwen2.5:7b
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Image: ComfyUI first (if a workflow is live), then free Pollinations Flux/Kontext (no key).
# Character passports + scene stills require a photograph when Pollinations is on.
# Location/prop passports stay geometric (quota goes to faces).
# Then OpenAI images if keyed, then geometric placeholder (offline / Pollinations off).
COMFYUI_URL=http://127.0.0.1:8188
OPENAI_IMAGE_MODEL=dall-e-3
POLLINATIONS_ENABLED=1
POLLINATIONS_URL=https://image.pollinations.ai
POLLINATIONS_MODEL=turbo

# Free I2V: public Hugging Face Spaces (ZeroGPU queue, no key). Set 0 to skip.
# Optional free HF account token — anonymous ZeroGPU often returns error null.
HF_TOKEN=
HF_I2V_ENABLED=1
HF_I2V_WAN_URL=https://multimodalart-wan2-1-fast.hf.space
HF_I2V_SPACE_URL=https://lightricks-ltx-video-distilled.hf.space

# Paid I2V: Pollinations Wan needs POLLINATIONS_KEY (pollen). Ken Burns remains the last fallback.
POLLINATIONS_KEY=
POLLINATIONS_VIDEO_ENABLED=1
POLLINATIONS_VIDEO_URL=https://gen.pollinations.ai
POLLINATIONS_VIDEO_MODEL=wan-fast

# Optional WaveSpeed I2V (HTTP, no SDK). Default Wan 2.2 480p Ultra Fast is $0.05 / 5s.
# Signup may show $1 trial; their blog says API keys often need a first top-up. Set HF_I2V_ENABLED=0
# if you want this trial spent instead of ZeroGPU.
WAVESPEED_API_KEY=
WAVESPEED_ENABLED=1
WAVESPEED_URL=https://api.wavespeed.ai/api/v3
WAVESPEED_MODEL=wavespeed-ai/wan-2.2/i2v-480p-ultra-fast
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Optional faster-whisper model (tiny/base/small). Used only if edge-tts word timestamps are missing.
WHISPER_MODEL=tiny

# Captions (ASS). Hex colors; karaoke highlight is the spoken word.
SUBTITLE_FONT=Arial
SUBTITLE_SIZE=64
SUBTITLE_PRIMARY=#FFFFFF
SUBTITLE_HIGHLIGHT=#FFE000
SUBTITLE_OUTLINE=#101010
SUBTITLE_OUTLINE_W=5
SUBTITLE_MARGIN_V=120

# BGM: first audio file in assets/music/ (not README). Duck VO via sidechaincompress, else volume mix.
BGM_ENABLED=1
BGM_VOLUME=0.14
BGM_DUCK=1

# API
API_HOST=127.0.0.1
API_PORT=8765
DATA_DIR=data
