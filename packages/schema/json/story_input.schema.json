{
  "$defs": {
    "Genre": {
      "enum": [
        "drama",
        "confession",
        "family",
        "cheating",
        "revenge",
        "twist"
      ],
      "title": "Genre",
      "type": "string"
    },
    "StoryMode": {
      "enum": [
        "idea",
        "script"
      ],
      "title": "StoryMode",
      "type": "string"
    }
  },
  "properties": {
